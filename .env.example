# Copy to .env, fill in, then: source .env
export MCP_URL="http://127.0.0.1:8000/mcp"   # any Streamable HTTP MCP server
# export MCP_TOKEN=""                        # optional, sent as "Authorization: Bearer ..."
export MODEL_PROVIDER="groq"                 # groq | bedrock | ollama
export GROQ_API_KEY=""                       # free key at console.groq.com (also enables Whisper voice input)
# export GROQ_MODEL="openai/gpt-oss-120b"
export ASSISTANT_NAME="Alexa"
# export SYSTEM_PROMPT_FILE="my_prompt.txt"
# export WHISPER_MODEL="whisper-large-v3-turbo"   # used when the browser's own speech recognition fails
# export WHISPER_LANGUAGE="en"
# export POLLY="off"                     # hide Amazon Polly voices (they need AWS credentials)
# export GROQ_STREAM="off"                # keep off: streaming gpt-oss on Groq can duplicate replies
# export VMS_DEBUG="1"                     # print each turn's raw messages in the terminal
